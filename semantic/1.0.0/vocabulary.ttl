@prefix isw: <https://example.org/isw/term/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/isw/term/concept/approved> a skos:Concept ;
    skos:definition "Fictional workbench concept: approved. No legal or insurer-specific meaning is implied."@en ;
    skos:prefLabel "Schváleno"@cs,
        "Freigegeben"@de,
        "Approved"@en ;
    skos:scopeNote "Only the invented demonstration operating profiles apply."@en ;
    isw:owner "Fictional domain steward" ;
    isw:status "approved" .

