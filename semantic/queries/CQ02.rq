PREFIX isw: <https://example.org/isw/term/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT * WHERE { VALUES ?case { <$CASE> } GRAPH <$GRAPH> { ?case isw:policy/isw:hasVersion ?version; isw:loss/isw:lossDate ?date. ?version isw:hasCoverage ?coverage; isw:validFrom ?from. OPTIONAL {?version isw:validTo ?to} FILTER(?from <= ?date && (!BOUND(?to) || ?date < ?to)) ?coverage isw:definition ?definition. } } LIMIT 100