PREFIX isw: <https://example.org/isw/term/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT * WHERE { VALUES ?case { <$CASE> } GRAPH <$GRAPH> { ?case isw:hasAssertion ?a, ?b. ?a isw:cause ?x; isw:text ?first. ?b isw:cause ?y; isw:text ?second. FILTER(?x != ?y) } } LIMIT 100