PREFIX isw: <https://example.org/isw/term/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT * WHERE { VALUES ?case { <$CASE> } GRAPH <$GRAPH> { ?case isw:evidence ?evidence. ?evidence prov:wasDerivedFrom ?source; isw:locator ?locator; isw:mappingRelease ?mapping. ?source isw:sha256 ?hash. } } LIMIT 100