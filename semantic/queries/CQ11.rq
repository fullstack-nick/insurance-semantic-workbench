PREFIX isw: <https://example.org/isw/term/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT * WHERE { VALUES ?case { <$CASE> } GRAPH <$GRAPH> { ?concept a skos:Concept; skos:prefLabel ?label. OPTIONAL {?concept skos:broader ?broader} } } LIMIT 150