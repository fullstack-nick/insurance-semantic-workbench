PREFIX isw: <https://example.org/isw/term/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT * WHERE { VALUES ?case { <$CASE> } GRAPH <$GRAPH> { ?case isw:country ?profile; isw:policy ?policy. ?policy isw:propertyCountry ?propertyCountry. OPTIONAL {?case isw:mitigation ?mitigation} } } LIMIT 100