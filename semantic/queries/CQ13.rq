PREFIX isw: <https://example.org/isw/term/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT * WHERE { VALUES ?case { <$CASE> } GRAPH <$GRAPH> { ?case isw:hasRole/isw:party ?party. ?party isw:crosswalk ?approvedIdentity. ?approvedIdentity isw:status "approved". } } LIMIT 100