PREFIX isw: <https://example.org/isw/term/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT * WHERE { VALUES ?case { <$CASE> } GRAPH <$GRAPH> { ?brief a isw:ReviewBrief; isw:projection ?projection; isw:release ?release; isw:evidenceBundle ?bundle. } } LIMIT 100